<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.IrisLens" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.IrisLens" parent="Base.Theme.IrisLens">
        <item name="colorPrimary">@color/iris_blue</item>
        <item name="colorPrimaryDark">@color/iris_blue</item>
    </style>

    <style name="manualSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">8dp</item>
        <item name="android:paddingBottom">32dp</item>
        <item name="android:gravity">center</item>
        <item name="android:importantForAccessibility">yes</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
    </style>
</resources>